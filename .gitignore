# 微信开发者工具私有配置（含本机 AppID / 编译设置，不入库）
project.private.config.json

# 编辑器与 IDE
.idea/
.vscode/
*.swp
*.swo

# 依赖目录（本项目无 npm 依赖，预留）
node_modules/
miniprogram_npm/
package-lock.json
pnpm-lock.yaml

# 系统与临时文件
.DS_Store
Thumbs.db
*.log
tmp/
dist/

# Python 缓存
__pycache__/
*.pyc

# 本地环境变量
.env
.env.*
!.env.example
# 开发工具/依赖（体积大、可重装，不入库）
.tools/

# 用户提供的字体（7.4 MB，体积过大不入库；路径与校验值见 docs/08）
HakkouMincho-v1.004/

