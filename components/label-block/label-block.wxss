/* 酒标式占位块：深胡桃底 + 内金框 + 分类名，不冒充产品照。
   与酒单页同一套视觉，抽成组件供管理端复用（顾客端保持原样）。 */
.lb {
  position: relative;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  background: #241610;
}

.lb::after {
  content: '';
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.32);
}

.lb--md {
  width: 132rpx;
  height: 168rpx;
}

.lb--sm {
  width: 96rpx;
  height: 124rpx;
}

.lb--xs {
  width: 64rpx;
  height: 84rpx;
}

.lb-cat {
  color: #C9A86E;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.lb--xs .lb-cat {
  font-size: 14rpx;
  letter-spacing: 0;
}

.lb-demo {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  color: rgba(160, 143, 126, 0.7);
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.lb--xs .lb-demo {
  display: none;
}