/* 背景层与前景层都位于品牌文字之下：靠大小、透明度与速度形成纵深，避免遮挡文字。 */
.petal-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  overflow: hidden;
  pointer-events: none;
}

.petal {
  position: absolute;
  top: -140rpx;
  display: block;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-fill-mode: both;
  will-change: transform;
}

.petal--back {
  z-index: 1;
}

.petal--front {
  z-index: 2;
}

.petal__image {
  display: block;
  width: 100%;
  height: 100%;
}

.petal--track-a {
  animation-name: petal-fall-a;
}

.petal--track-b {
  animation-name: petal-fall-b;
}

.petal--track-c {
  animation-name: petal-fall-c;
}

.petal--track-d {
  animation-name: petal-fall-d;
}

.petal-layer.is-paused .petal {
  animation-play-state: paused;
}

@keyframes petal-fall-a {
  0% {
    transform: translate3d(0, -6vh, 0) rotate(0deg);
  }
  100% {
    transform: translate3d(80rpx, 120vh, 0) rotate(360deg);
  }
}

@keyframes petal-fall-b {
  0% {
    transform: translate3d(0, -6vh, 0) rotate(24deg);
  }
  50% {
    transform: translate3d(-70rpx, 52vh, 0) rotate(220deg);
  }
  100% {
    transform: translate3d(36rpx, 120vh, 0) rotate(420deg);
  }
}

@keyframes petal-fall-c {
  0% {
    transform: translate3d(0, -6vh, 0) rotate(-18deg);
  }
  45% {
    transform: translate3d(64rpx, 46vh, 0) rotate(150deg);
  }
  100% {
    transform: translate3d(-28rpx, 120vh, 0) rotate(360deg);
  }
}

@keyframes petal-fall-d {
  0% {
    transform: translate3d(0, -6vh, 0) rotate(10deg);
  }
  50% {
    transform: translate3d(-80rpx, 50vh, 0) rotate(260deg);
  }
  100% {
    transform: translate3d(18rpx, 120vh, 0) rotate(540deg);
  }
}