.product-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 100%;
  border: 1rpx solid rgba(201, 168, 110, 0.16);
  border-radius: 16rpx;
  background: #17110D;
}

.product-cover {
  position: relative;
  width: 100%;
  height: 220rpx;
}

.product-cover-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 2rpx 10rpx;
  border: 1rpx solid rgba(244, 236, 223, 0.35);
  border-radius: 999rpx;
  color: rgba(244, 236, 223, 0.75);
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.product-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 20rpx;
}

.product-name {
  color: #F4ECDF;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.product-name-en {
  margin-top: 2rpx;
  color: #A08F7E;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.product-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: #A08F7E;
  font-size: 22rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 18rpx;
}

.product-price {
  color: #D9A45B;
  font-size: 34rpx;
  letter-spacing: 1rpx;
}

.product-yen {
  margin-right: 2rpx;
  font-size: 22rpx;
}

.product-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid rgba(217, 164, 91, 0.6);
  border-radius: 50%;
  color: #D9A45B;
  font-size: 34rpx;
  line-height: 1;
}