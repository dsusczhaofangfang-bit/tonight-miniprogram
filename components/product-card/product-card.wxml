<view class="product-card" bindtap="onTap">
  <image
    wx:if="{{image && !imageFailed}}"
    class="product-img"
    src="{{image}}"
    mode="aspectFill"
    binderror="onImageError"
  />
  <view wx:else class="product-cover" style="background: {{cover}};">
    <text class="product-cover-tag">示例</text>
  </view>
  <view class="product-body">
    <text class="product-name">{{product.name}}</text>
    <text class="product-name-en">{{product.nameEn}}</text>
    <text class="product-desc">{{product.description}}</text>
    <view class="product-footer">
      <view class="product-price"><text class="product-yen">¥</text>{{priceText}}</view>
      <view class="product-add {{product.isAvailable === false ? 'is-disabled' : ''}}" catchtap="onAdd">＋</view>
    </view>
  </view>
</view>