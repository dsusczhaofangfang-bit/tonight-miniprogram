/* 花瓣场：整个组件压在玫瑰之下（z-index 1 < rose-stage 的 3），
   hero 与 ambient 再各自分层。文字恒在 z-index 6，花瓣不可能遮挡文字。 */
.petal-field {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  overflow: hidden;
  pointer-events: none;
}

.petal-field__ambient {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
}

.petal-field__hero {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
}

/* ---------- 环境层：无限循环 ---------- */

.petal-field__amb {
  position: absolute;
  top: -180rpx;
  display: block;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-fill-mode: both;
  will-change: transform;
}

.petal-field__amb-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* ---------- 主角层：从玫瑰中心散开 ---------- */

/* 原点必须等于玫瑰中心：rose-stage 的 top:30vh + 高度 442rpx 的一半。
   改玫瑰尺寸时必须同步这里。 */
.petal-field__hero-item {
  position: absolute;
  top: calc(30vh + 221rpx);
  left: 50%;
  width: 0;
  height: 0;
  animation-duration: 8s, 320ms;
  animation-delay: 1s, 900ms;
  animation-fill-mode: both, both;
  will-change: transform;
}

.petal-field__hero-img {
  position: absolute;
  top: 50%;
  left: 50%;
  display: block;
  transform: translate(-50%, -50%);
}

.petal-field__hero-img--mirror {
  transform: translate(-50%, -50%) scaleX(-1);
}

.petal-field.is-paused .petal-field__amb,
.petal-field.is-paused .petal-field__hero-item {
  animation-play-state: paused;
}

/* ---------- 环境层轨迹 ---------- */

@keyframes track-a {
  0% {
    transform: translate3d(0, -8vh, 0) rotate(0deg);
  }
  100% {
    transform: translate3d(80rpx, 120vh, 0) rotate(360deg);
  }
}

@keyframes track-b {
  0% {
    transform: translate3d(0, -8vh, 0) rotate(24deg);
  }
  52% {
    transform: translate3d(-70rpx, 52vh, 0) rotate(220deg);
  }
  100% {
    transform: translate3d(36rpx, 120vh, 0) rotate(420deg);
  }
}

@keyframes track-c {
  0% {
    transform: translate3d(0, -8vh, 0) rotate(-18deg);
  }
  46% {
    transform: translate3d(64rpx, 46vh, 0) rotate(150deg);
  }
  100% {
    transform: translate3d(-28rpx, 120vh, 0) rotate(360deg);
  }
}

@keyframes track-d {
  0% {
    transform: translate3d(0, -8vh, 0) rotate(10deg);
  }
  50% {
    transform: translate3d(-80rpx, 50vh, 0) rotate(260deg);
  }
  100% {
    transform: translate3d(18rpx, 120vh, 0) rotate(540deg);
  }
}

/* 近景专用：横向漂移压到 ±24rpx，保证大花瓣始终留在两侧安全带内 */
@keyframes near-a {
  0% {
    transform: translate3d(0, -12vh, 0) rotate(0deg) scale(1.08);
  }
  100% {
    transform: translate3d(24rpx, 120vh, 0) rotate(170deg) scale(1.14);
  }
}

@keyframes near-b {
  0% {
    transform: translate3d(0, -12vh, 0) rotate(-12deg) scale(1.06);
  }
  100% {
    transform: translate3d(-20rpx, 120vh, 0) rotate(-190deg) scale(1.12);
  }
}

.petal-field__amb.track-a {
  animation-name: track-a;
}

.petal-field__amb.track-b {
  animation-name: track-b;
}

.petal-field__amb.track-c {
  animation-name: track-c;
}

.petal-field__amb.track-d {
  animation-name: track-d;
}

.petal-field__amb.near-a {
  animation-name: near-a;
}

.petal-field__amb.near-b {
  animation-name: near-b;
}

/* ---------- 主角层：12 条爆发轨迹 ----------
   0% 停在簇内坐标（被不透明玫瑰遮住）；
   8% / 15% 完成外扩与旋转（对应 1.0s–2.2s 的解体）；
   15% 之后改为 linear，转为匀速飘落直到出屏。
   每条 keyframe 自带 timing-function，避免整段共用一个缓动曲线导致"飘落突然停住"。 */

