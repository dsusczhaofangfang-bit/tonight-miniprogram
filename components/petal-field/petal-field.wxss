  }
  8% {
    transform: translate3d(-149rpx, -98rpx, 0) scale(0.7) rotate(-148deg);
    animation-timing-function: cubic-bezier(0.16, 0.84, 0.44, 1);
  }
  15% {
    transform: translate3d(-209rpx, -134rpx, 0) scale(0.92) rotate(-224deg);
    animation-timing-function: linear;
  }
  100% {
    transform: translate3d(-246rpx, 120vh, 0) scale(1.05) rotate(-330deg);
  }
}

