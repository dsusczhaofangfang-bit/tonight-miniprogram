/* 花瓣在玫瑰还半透明时不应该是糊在玫瑰后面的暗块，
   所以让它们从 1.0s 起才淡入，与玫瑰淡出同步。 */
@keyframes hero-fade {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}
