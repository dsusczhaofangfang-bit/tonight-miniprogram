.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 32rpx;
}

.empty-mark {
  width: 12rpx;
  height: 12rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.6);
  border-radius: 50%;
}

.empty-text {
  color: #A08F7E;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.empty-hint {
  margin-top: 12rpx;
  color: rgba(160, 143, 126, 0.7);
  font-size: 22rpx;
}