/* 老板管理端公共样式：只在 admin-* 页面引用，不影响顾客端。
   延续深色复古酒馆：墨黑底、胡桃木、香槟金、米白；管理端偏效率，
   用细线分隔代替卡片堆叠，不加阴影、不加动效（全站仅欢迎页有动效）。 */

.admin-page {
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background: #0B0A09;
}

/* 顶条：品牌 + 演示标识 + 退出 / 返回顾客端 */
.admin-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 26rpx 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(201, 168, 110, 0.25);
}

.admin-brand {
  display: block;
  color: #F4ECDF;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 30rpx;
  letter-spacing: 6rpx;
}

.admin-sub {
  display: block;
  margin-top: 6rpx;
  color: #A08F7E;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.admin-top-actions {
  display: flex;
  flex: none;
  align-items: center;
}

.admin-top-link {
  padding: 6rpx 0 6rpx 24rpx;
  color: #C9A86E;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.admin-body {
  padding: 30rpx 32rpx 0;
}

/* 区块标题与说明 */
.admin-section {
  margin-top: 36rpx;
}

.admin-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(201, 168, 110, 0.25);
}

.admin-section-title {
  color: #C9A86E;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.admin-section-more {
  padding: 6rpx 0 6rpx 20rpx;
  color: #A08F7E;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.admin-note {
  margin-top: 18rpx;
  color: rgba(160, 143, 126, 0.85);
  font-size: 21rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.admin-note--warn {
  padding-left: 16rpx;
  border-left: 4rpx solid #A32B41;
  color: #D9A45B;
}

/* 按钮：主操作 88rpx 高，方便单手点；次操作描边 */
.admin-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 4rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.admin-btn--primary {
  border: 1rpx solid rgba(201, 168, 110, 0.45);
  background: linear-gradient(135deg, #5A1A24, #7A2433);
  color: #F4ECDF;
}

.admin-btn--ghost {
  border: 1rpx solid rgba(201, 168, 110, 0.45);
  color: #C9A86E;
}

.admin-btn--danger {
  border: 1rpx solid rgba(163, 43, 65, 0.7);
  color: #D08A93;
}

.admin-btn--disabled {
  opacity: 0.45;
}

.admin-btn--pressed {
  opacity: 0.78;
}

/* 筛选 chip：横向滚动，激活项金色描边 */
.chip-scroll {
  width: 100%;
  white-space: nowrap;
}

.chip-bar {
  white-space: nowrap;
  padding: 18rpx 0 6rpx;
}

.chip {
  display: inline-block;
  height: 64rpx;
  margin-right: 14rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.28);
  border-radius: 4rpx;
  color: #A08F7E;
  font-size: 24rpx;
  line-height: 64rpx;
  letter-spacing: 1rpx;
}

.chip.is-active {
  border-color: rgba(217, 164, 91, 0.75);
  background: rgba(217, 164, 91, 0.12);
  color: #F4ECDF;
}

.chip-count {
  margin-left: 8rpx;
  color: rgba(217, 164, 91, 0.9);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20rpx;
}

/* 列表：细线分隔，不用卡片 */
.admin-list {
  border-top: 1rpx solid rgba(201, 168, 110, 0.14);
}

.admin-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(201, 168, 110, 0.14);
}

.admin-row--pressed {
  opacity: 0.75;
}

/* 表单 */
.admin-field {
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(201, 168, 110, 0.14);
}

.admin-field-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.admin-label {
  color: #A08F7E;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.admin-required {
  color: #A32B41;
}

.admin-input {
  width: 100%;
  height: 76rpx;
  color: #F4ECDF;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.admin-input--number {
  font-family: Georgia, "Times New Roman", serif;
}

.admin-input-placeholder {
  color: rgba(160, 143, 126, 0.55);
  font-size: 26rpx;
}

.admin-textarea {
  width: 100%;
  min-height: 132rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.22);
  border-radius: 4rpx;
  background: #17110D;
  color: #F4ECDF;
  font-size: 26rpx;
  line-height: 1.6;
}

.admin-counter {
  display: block;
  margin-top: 8rpx;
  color: rgba(160, 143, 126, 0.7);
  font-size: 20rpx;
  text-align: right;
}

.admin-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  border-bottom: 1rpx solid rgba(201, 168, 110, 0.14);
}

.admin-picker-value {
  color: #F4ECDF;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.admin-picker-hint {
  color: #C9A86E;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.admin-error {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-left: 4rpx solid #A32B41;
  background: rgba(163, 43, 65, 0.1);
  color: #D9A45B;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 金额：统一等宽衬线数字 */
.admin-money {
  color: #D9A45B;
  font-family: Georgia, "Times New Roman", serif;
  letter-spacing: 1rpx;
}

.admin-money-unit {
  margin-right: 2rpx;
  font-size: 20rpx;
}