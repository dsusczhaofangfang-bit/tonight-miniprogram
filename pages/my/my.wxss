.my-page {
  padding-top: 48rpx;
}

.profile {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.5);
  border-radius: 50%;
  background: rgba(90, 26, 36, 0.6);
  color: #F4ECDF;
  font-size: 40rpx;
}

.profile-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 24rpx;
}

.profile-name {
  color: #F4ECDF;
  font-size: 32rpx;
  letter-spacing: 2rpx;
}

.profile-hint {
  margin-top: 4rpx;
  color: #A08F7E;
  font-size: 22rpx;
}

.entry-group {
  margin-top: 32rpx;
  padding: 0 28rpx;
}

.entry-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  border-bottom: 1rpx solid rgba(201, 168, 110, 0.12);
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-label {
  color: #F4ECDF;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.entry-value {
  color: #A08F7E;
  font-size: 24rpx;
}

.entry-dev {
  color: #D9A45B;
  letter-spacing: 2rpx;
}

/* 已登录老板：入口值用金色区分，避免与普通条目混淆 */
.entry-owner {
  color: #D9A45B;
  letter-spacing: 1rpx;
}

/* 已登录调酒师：同样用金色，但文案标识角色不同 */
.entry-staff {
  color: #D9A45B;
  letter-spacing: 1rpx;
}

.my-footer {
  margin-top: 64rpx;
  color: rgba(160, 143, 126, 0.6);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-align: center;
}