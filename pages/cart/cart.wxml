<view class="cart">
  <view class="cart-head">
    <text class="cart-title">购物车</text>
    <text class="cart-clear" wx:if="{{items.length}}" bindtap="onClear">清空</text>
  </view>

  <view class="cart-list" wx:if="{{items.length}}">
    <view class="cart-item" wx:for="{{items}}" wx:key="productId">
      <view
        class="check {{item.selected ? 'is-checked' : ''}}"
        data-id="{{item.productId}}"
        catchtap="onToggle"
      >
        <text class="check-mark" wx:if="{{item.selected}}">✓</text>
      </view>

      <view class="item-main">
        <text class="item-name">{{item.name}}</text>
        <text class="item-en">{{item.nameEn}}</text>
        <view class="item-meta">
          <text class="item-price">¥{{item.priceText}}</text>
          <text class="item-sub">小计 ¥{{item.subtotalText}}</text>
        </view>
      </view>

      <view class="item-side">
        <text class="item-remove" data-id="{{item.productId}}" catchtap="onRemove">移除</text>
        <quantity-stepper
          value="{{item.qty}}"
          min="{{1}}"
          max="{{99}}"
          data-id="{{item.productId}}"
          bind:change="onQtyChange"
        ></quantity-stepper>
      </view>
    </view>
  </view>

  <block wx:if="{{!loading && !items.length}}">
    <empty-state text="购物车是空的" hint="从酒单里挑一杯，今晚慢慢喝"></empty-state>
    <view class="empty-action">
      <view class="ghost-btn" hover-class="ghost-btn--pressed" bindtap="onGoMenu">去酒单</view>
    </view>
  </block>

  <view class="cart-foot" wx:if="{{items.length}}">
    <view class="foot-note">演示模式 · 提交订单不会产生真实支付</view>
    <view class="cart-bar">
      <view class="bar-select" catchtap="onToggleAll">
        <view class="check {{allSelected ? 'is-checked' : ''}}">
          <text class="check-mark" wx:if="{{allSelected}}">✓</text>
        </view>
        <text class="bar-select-text">全选</text>
      </view>

      <view class="bar-total">
        <text class="bar-label">合计</text>
        <text class="bar-amount">¥{{selectedText}}</text>
        <text class="bar-qty">已选 {{selectedQty}} 件</text>
      </view>

      <view
        class="bar-btn {{selectedQty > 0 ? '' : 'is-disabled'}}"
        hover-class="{{selectedQty > 0 ? 'bar-btn--pressed' : 'none'}}"
        bindtap="onCheckout"
      >去结算</view>
    </view>
  </view>
</view>