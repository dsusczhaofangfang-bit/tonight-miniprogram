.dev-page {
  padding-top: 40rpx;
}

.dev-head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 8rpx 32rpx;
}

.dev-title {
  color: #F4ECDF;
  font-size: 44rpx;
  letter-spacing: 6rpx;
}

.dev-sub {
  margin-top: 8rpx;
  color: #A08F7E;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.check-list {
  padding: 8rpx 28rpx;
}

.check-item {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid rgba(201, 168, 110, 0.12);
}

.check-item:last-child {
  border-bottom: none;
}

.check-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 20rpx;
  border-radius: 50%;
}

.check-dot.is-ok {
  background: #9DB39A;
}

.check-dot.is-fail {
  background: #D06A7C;
}

.check-name {
  width: 160rpx;
  color: #F4ECDF;
  font-size: 26rpx;
}

.check-detail {
  flex: 1;
  color: #A08F7E;
  font-size: 22rpx;
  text-align: right;
}

.check-empty {
  padding: 48rpx 0;
  color: #A08F7E;
  font-size: 24rpx;
  text-align: center;
}

.dev-actions {
  display: flex;
  margin-top: 40rpx;
}

.dev-actions .btn {
  flex: 1;
}

.reset-btn {
  margin-left: 20rpx;
}

.dev-note {
  margin-top: 40rpx;
  padding: 0 8rpx;
  color: rgba(160, 143, 126, 0.6);
  font-size: 20rpx;
  line-height: 1.8;
}