/* 酒单：左侧竖排分类栏 + 右侧编辑式列表（docs/04 §3、docs/05 §3.3）。
   约束：不做双列卡片货架、不用圆角卡片与投影、不加箭头；
   无真实商品图时用酒标式占位块，有图时自动换成真实图片。 */

.menu {
  min-height: 100vh;
  padding: 0 32rpx 56rpx;
  background: #0B0A09;
}

/* 搜索栏常驻：滚动时压在列表上方 */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  height: 104rpx;
  border-bottom: 1rpx solid rgba(201, 168, 110, 0.22);
  background: #0B0A09;
}

.search-input {
  flex: 1;
  height: 72rpx;
  color: #F4ECDF;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.search-placeholder {
  color: rgba(160, 143, 126, 0.7);
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.search-clear {
  padding: 12rpx 0 12rpx 28rpx;
  color: #C9A86E;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.menu-body {
  display: flex;
  align-items: flex-start;
  padding-top: 20rpx;
}

/* 分类栏：160rpx（最长分类名「无酒精饮品」5 字），激活项用 4rpx 玫瑰红竖条 + 米白文字 */
.rail {
  position: sticky;
  top: 104rpx;
  flex: none;
  align-self: flex-start;
  width: 160rpx;
  padding-bottom: 24rpx;
}

.rail-item {
  position: relative;
  padding: 22rpx 0 22rpx 24rpx;
  color: #A08F7E;
  font-size: 24rpx;
  line-height: 1.3;
  letter-spacing: 1rpx;
  transition: color 180ms ease-out;
}

.rail-item::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: 4rpx;
  height: 28rpx;
  background: #A32B41;
  opacity: 0;
  transform: translateY(-50%) scaleY(0.2);
  transition: transform 180ms ease-out, opacity 180ms ease-out;
}

.rail-item.is-active {
  color: #F4ECDF;
}

.rail-item.is-active::before {
  opacity: 1;
  transform: translateY(-50%) scaleY(1);
}

.rail-name {
  display: block;
  white-space: nowrap;
}

.list {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 4rpx 0 18rpx;
  border-bottom: 1rpx solid rgba(201, 168, 110, 0.25);
}

.list-title {
  color: #C9A86E;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.list-note {
  color: rgba(160, 143, 126, 0.8);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* 商品条目：左酒标块 + 右文字，条目间只用细线分隔 */
.item {
  display: flex;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(201, 168, 110, 0.14);
}

.item--pressed {
  opacity: 0.72;
}

.item-img {
  flex: none;
  width: 132rpx;
  height: 168rpx;
  margin-right: 22rpx;
  background: #241610;
}

/* 酒标式占位块：深胡桃底 + 内金框 + 分类名，不冒充产品照 */
.label-block {
  position: relative;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 168rpx;
  margin-right: 22rpx;
  background: #241610;
}

.label-block::after {
  content: '';
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.32);
}

.label-cat {
  color: #C9A86E;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  text-indent: 1rpx;
  white-space: nowrap;
}

.label-demo {
  position: absolute;
  right: 12rpx;
  bottom: 10rpx;
  color: rgba(160, 143, 126, 0.7);
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.item-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.item-name {
  overflow: hidden;
  color: #F4ECDF;
  font-size: 30rpx;
  line-height: 1.35;
  letter-spacing: 1rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-en {
  overflow: hidden;
  margin-top: 4rpx;
  color: #A08F7E;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: rgba(160, 143, 126, 0.9);
  font-size: 21rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 14rpx;
}

.item-price {
  color: #D9A45B;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 30rpx;
  letter-spacing: 1rpx;
}

.yen {
  margin-right: 2rpx;
  font-size: 20rpx;
}

.item-actions {
  display: flex;
  align-items: center;
}

.item-detail {
  padding: 8rpx 20rpx 8rpx 0;
  color: #A08F7E;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.item-add {
  padding: 6rpx 22rpx;
  border: 1rpx solid rgba(217, 164, 91, 0.55);
  border-radius: 4rpx;
  color: #D9A45B;
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 4rpx;
  text-indent: 4rpx;
}

.item-add--pressed {
  background: rgba(217, 164, 91, 0.14);
}

/* 加载骨架：静态占位，不做闪光动画（全站仅欢迎页有动效） */
.item--skeleton {
  pointer-events: none;
}

.label-block--empty {
  background: #1A1310;
}

.label-block--empty::after {
  border-color: rgba(201, 168, 110, 0.1);
}

.item--skeleton .item-body {
  padding-top: 6rpx;
}

.sk-line {
  height: 16rpx;
  margin-bottom: 18rpx;
  border-radius: 2rpx;
  background: rgba(201, 168, 110, 0.1);
}

.sk-line--wide {
  width: 72%;
  height: 20rpx;
}

.sk-line--short {
  width: 44%;
}