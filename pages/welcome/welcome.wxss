/* 欢迎页：纯文字版（玫瑰与花瓣效果已移除）
   0.10 中文 / 0.26 英文 / 0.38 细线 / 0.52 欢迎语 / 0.80 跳过 / 0.90 按钮 */

.welcome {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 30%, #14100E 0%, #0B0A09 62%, #0B0A09 100%);
  -webkit-tap-highlight-color: transparent;
}

.welcome-brand {
  position: absolute;
  top: 46%;
  right: 0;
  left: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  transform: translateY(-50%);
  pointer-events: none;
}

.brand-cn {
  color: #F4ECDF;
  font-family: "Songti SC", "Noto Serif SC", "STSong", "SimSun", serif;
  font-size: 84rpx;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 18rpx;
  text-indent: 18rpx;
  animation: brand-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s both;
}

.brand-en {
  margin-top: 24rpx;
  color: rgba(201, 168, 110, 0.85);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 10rpx;
  text-indent: 10rpx;
  animation: brand-rise 600ms cubic-bezier(0.2, 0.7, 0.2, 1) 0.26s both;
}

.brand-rule {
  width: 96rpx;
  height: 1rpx;
  margin: 34rpx 0 34rpx;
  background: rgba(201, 168, 110, 0.55);
  transform-origin: center;
  animation: rule-open 600ms ease-out 0.38s both;
}

.welcome-copy {
  color: #A08F7E;
  font-family: "PingFang SC", "Noto Sans SC", "Helvetica Neue", sans-serif;
  font-size: 26rpx;
  line-height: 2;
  letter-spacing: 3rpx;
  text-align: center;
  animation: brand-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) 0.52s both;
}

.welcome-copy text {
  display: block;
}

.skip {
  position: absolute;
  top: 56rpx;
  top: calc(56rpx + env(safe-area-inset-top));
  right: 20rpx;
  z-index: 3;
  padding: 16rpx 22rpx;
  color: rgba(160, 143, 126, 0.78);
  font-family: "PingFang SC", "Noto Sans SC", "Helvetica Neue", sans-serif;
  font-size: 24rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  animation: fade-in 300ms ease-out 0.8s both;
}

.skip--pressed {
  opacity: 0.5;
}

.welcome-actions {
  position: absolute;
  right: 0;
  bottom: 76rpx;
  bottom: calc(76rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 2;
  display: flex;
  justify-content: center;
  animation: brand-rise 600ms cubic-bezier(0.2, 0.7, 0.2, 1) 0.9s both;
}

/* 香槟金细描边，不用大面积红色胶囊 */
.enter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 88rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.55);
  border-radius: 0;
  background: linear-gradient(180deg, rgba(201, 168, 110, 0.07) 0%, rgba(201, 168, 110, 0.02) 100%);
  color: #EFE2CB;
  font-family: "Songti SC", "Noto Serif SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  line-height: 1;
  letter-spacing: 10rpx;
  text-indent: 10rpx;
}

.enter-btn--pressed {
  background: rgba(201, 168, 110, 0.14);
  opacity: 0.9;
}

@keyframes brand-rise {
  0% {
    opacity: 0;
    transform: translate3d(0, 16rpx, 0);
  }
  100% {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes rule-open {
  0% {
    opacity: 0;
    transform: scaleX(0.35);
  }
  100% {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes fade-in {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}