@import "../../styles/font-hakkou.wxss";

/* 欢迎页：纯文字排版。
   约束：不用渐变、光晕、阴影、边框、分割线；层次只靠字号、字距、颜色和留白。
   字体：八公明朝为主，6 个简体缺字由思源宋体 SC 补（详见 docs/08）。 */

.welcome {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #100D0E;
  font-family: "HakkouMincho", "HakkouFallbackSC", "Songti SC", "STSong", serif;
  -webkit-tap-highlight-color: transparent;
}

.skip {
  position: absolute;
  top: 44rpx;
  top: calc(44rpx + env(safe-area-inset-top));
  right: 8rpx;
  z-index: 2;
  padding: 20rpx 28rpx;
  color: #B58A53;
  font-size: 26rpx;
  line-height: 1;
  letter-spacing: 5rpx;
  text-indent: 5rpx;
  animation: fade 420ms ease-out 0.6s both;
}

.skip--pressed {
  opacity: 0.45;
}

.stage {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 72rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-cn {
  color: #E8D9BE;
  font-size: 120rpx;
  line-height: 1.15;
  letter-spacing: 16rpx;
  text-indent: 16rpx;
  animation: fade 520ms ease-out 0.1s both;
}

.brand-en {
  margin-top: 34rpx;
  color: #B58A53;
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 9rpx;
  text-indent: 9rpx;
  animation: fade 520ms ease-out 0.24s both;
}

.greeting {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 140rpx;
}

.greeting-cn {
  color: #E8D9BE;
  font-size: 37rpx;
  line-height: 1.6;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  animation: fade 520ms ease-out 0.4s both;
}

.greeting-sub {
  margin-top: 26rpx;
  color: #B58A53;
  font-size: 28rpx;
  line-height: 1.6;
  letter-spacing: 5rpx;
  text-indent: 5rpx;
  animation: fade 520ms ease-out 0.52s both;
}

.greeting-en {
  margin-top: 48rpx;
  color: #B58A53;
  font-size: 20rpx;
  line-height: 1.6;
  letter-spacing: 7rpx;
  text-indent: 7rpx;
  animation: fade 520ms ease-out 0.62s both;
}

.footer {
  padding: 0 0 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  text-align: center;
}

/* 纯文字入口：无背景、无描边、无圆角 */
.enter {
  display: inline-block;
  padding: 24rpx 40rpx;
  color: #E8D9BE;
  font-size: 32rpx;
  line-height: 1;
  letter-spacing: 20rpx;
  text-indent: 18rpx;
  animation: fade 520ms ease-out 0.85s both;
}

.enter--pressed {
  opacity: 0.55;
}

@keyframes fade {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}