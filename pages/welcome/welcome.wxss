.welcome {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  overflow: hidden;
  background: radial-gradient(circle at 50% 26%, #2A1118 0%, #0B0A09 62%);
  -webkit-tap-highlight-color: transparent;
}

.welcome-glow {
  position: absolute;
  top: -30%;
  left: 50%;
  width: 1100rpx;
  height: 1100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(163, 43, 65, 0.3) 0%, rgba(163, 43, 65, 0) 68%);
  transform: translateX(-50%);
  transform-origin: center;
  pointer-events: none;
  z-index: 0;
  animation: glow-breathe 6s ease-in-out 0.2s 1 both;
}

.welcome-brand {
  position: absolute;
  top: 50%;
  right: 0;
  left: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  transform: translateY(-52%);
}

.brand-cn {
  color: #F4ECDF;
  font-family: "Songti SC", "Noto Serif SC", "STSong", "SimSun", serif;
  font-size: 88rpx;
  line-height: 1.15;
  letter-spacing: 16rpx;
  text-indent: 16rpx;
  animation: welcome-rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 1s both;
}

.brand-en {
  margin-top: 20rpx;
  color: rgba(201, 168, 110, 0.85);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  animation: welcome-rise 0.6s ease-out 1.6s both;
}

.brand-rule {
  width: 96rpx;
  height: 1rpx;
  margin: 36rpx 0 40rpx;
  background: rgba(201, 168, 110, 0.55);
  transform-origin: center;
  animation: welcome-rule 0.7s ease-out 1.7s both;
}

.welcome-copy {
  color: #A08F7E;
  font-size: 28rpx;
  line-height: 1.9;
  letter-spacing: 2rpx;
  text-align: center;
  animation: welcome-rise 0.7s ease-out 2.1s both;
}

.welcome-copy text {
  display: block;
}

.skip {
  position: absolute;
  top: 56rpx;
  top: calc(56rpx + env(safe-area-inset-top));
  right: 20rpx;
  z-index: 4;
  padding: 16rpx 20rpx;
  color: rgba(160, 143, 126, 0.8);
  font-size: 24rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  animation: welcome-fade 0.5s ease-out 0.8s both;
}

.skip--pressed {
  opacity: 0.55;
}

.welcome-actions {
  position: absolute;
  right: 0;
  bottom: 72rpx;
  bottom: calc(72rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 3;
  display: flex;
  justify-content: center;
  animation: welcome-rise 0.6s ease-out 2.6s both;
}

.enter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 92rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.5);
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5A1A24, #7A2433);
  color: #F4ECDF;
  font-size: 30rpx;
  line-height: 1;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
}

.enter-btn--pressed {
  opacity: 0.86;
}

@keyframes welcome-rise {
  0% {
    opacity: 0;
    transform: translate3d(0, 18rpx, 0);
  }
  100% {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes welcome-fade {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

@keyframes welcome-rule {
  0% {
    opacity: 0;
    transform: scaleX(0.4);
  }
  100% {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes glow-breathe {
  0% {
    opacity: 0.72;
    transform: translateX(-50%) scale(1);
  }
  45% {
    opacity: 1;
    transform: translateX(-50%) scale(1.04);
  }
  100% {
    opacity: 0.72;
    transform: translateX(-50%) scale(1);
  }
}