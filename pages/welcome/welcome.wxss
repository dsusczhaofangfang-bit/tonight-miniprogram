.welcome {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  overflow: hidden;
  background: radial-gradient(circle at 50% 28%, #2A1118 0%, #0B0A09 62%);
}

.welcome-glow {
  position: absolute;
  top: -24%;
  left: 50%;
  width: 960rpx;
  height: 960rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(163, 43, 65, 0.3) 0%, rgba(163, 43, 65, 0) 70%);
  transform: translateX(-50%);
}

.welcome-brand {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 56rpx;
}

.brand-en {
  color: rgba(201, 168, 110, 0.85);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20rpx;
  letter-spacing: 8rpx;
}

.brand-cn {
  margin-top: 36rpx;
  color: #F4ECDF;
  font-size: 88rpx;
  letter-spacing: 16rpx;
  text-indent: 16rpx;
}

.brand-rule {
  width: 96rpx;
  height: 1rpx;
  margin: 40rpx 0;
  background: rgba(201, 168, 110, 0.55);
}

.brand-slogan {
  color: #A08F7E;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  line-height: 2;
  text-align: center;
}

.welcome-actions {
  position: absolute;
  bottom: calc(88rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.enter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 92rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.5);
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5A1A24, #7A2433);
  color: #F4ECDF;
  font-size: 30rpx;
  letter-spacing: 8rpx;
}

.skip-btn {
  margin-top: 32rpx;
  color: rgba(160, 143, 126, 0.8);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}