<view class="welcome">
  <view class="skip" hover-class="skip--pressed" bindtap="onSkip">跳过</view>

  <view class="stage">
    <view class="brand">
      <text class="brand-cn">Tonight</text>
      <text class="brand-en">COCKTAIL &amp; WHISKEY BAR</text>
    </view>

    <view class="greeting">
      <text class="greeting-cn">今夜，来点不一样的。</text>
      <text class="greeting-sub">欢迎来到 <text class="greeting-brand">Tonight</text>。</text>
      <text class="greeting-en">A DIFFERENT KIND OF NIGHT.</text>
    </view>
  </view>

  <view class="footer">
    <view class="enter" hover-class="enter--pressed" bindtap="onEnter">进入酒馆</view>
  </view>
</view>