<view class="welcome">
  <view class="welcome-glow"></view>

  <view class="welcome-brand">
    <text class="brand-en">COCKTAIL &amp; WHISKEY BAR</text>
    <text class="brand-cn">柠舍唔同</text>
    <view class="brand-rule"></view>
    <text class="brand-slogan">今夜，来点不一样的。欢迎来到柠舍唔同。</text>
  </view>

  <view class="welcome-actions">
    <button class="enter-btn" bindtap="onEnter">进入酒馆</button>
    <text class="skip-btn" bindtap="onSkip">跳过</text>
  </view>
</view>