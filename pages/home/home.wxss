.home-page {
  padding-top: 56rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 24rpx 56rpx;
}

.hero-eyebrow {
  color: rgba(201, 168, 110, 0.8);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20rpx;
  letter-spacing: 8rpx;
}

.hero-title {
  margin-top: 28rpx;
  color: #F4ECDF;
  font-size: 76rpx;
  letter-spacing: 14rpx;
  text-indent: 14rpx;
}

.hero-rule {
  width: 88rpx;
  height: 1rpx;
  margin: 32rpx 0;
  background: rgba(201, 168, 110, 0.55);
}

.hero-slogan {
  color: #A08F7E;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.hero-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-top: 64rpx;
}

.hero-btn {
  width: 420rpx;
}

.hero-link {
  margin-top: 28rpx;
  color: #C9A86E;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.shop-card {
  margin-top: 16rpx;
}

.shop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.shop-title {
  color: #C9A86E;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.shop-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(201, 168, 110, 0.12);
}

.shop-label {
  width: 100rpx;
  color: #A08F7E;
  font-size: 24rpx;
}

.shop-value {
  flex: 1;
  color: #F4ECDF;
  font-size: 26rpx;
}

.shop-actions {
  display: flex;
  margin-top: 24rpx;
}

.shop-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 72rpx;
  margin-right: 20rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.35);
  border-radius: 10rpx;
  color: #C9A86E;
  font-size: 24rpx;
}

.shop-action:last-child {
  margin-right: 0;
}

.home-footer {
  margin-top: 56rpx;
  color: rgba(160, 143, 126, 0.6);
  font-size: 20rpx;
  text-align: center;
  letter-spacing: 2rpx;
}