<view class="product" wx:if="{{product}}">
  <view class="cover">
    <image
      wx:if="{{product.image && !imageFailed}}"
      class="cover-img"
      src="{{product.image}}"
      mode="aspectFill"
      binderror="onImageError"
    />
    <block wx:else>
      <view class="cover-frame"></view>
      <text class="cover-cat">{{categoryName}}</text>
      <text class="cover-en" wx:if="{{categoryNameEn}}">{{categoryNameEn}}</text>
      <text class="cover-demo">示例图 · 待替换为真实商品图</text>
    </block>
  </view>

  <view class="panel">
    <view class="panel-meta">
      <text class="panel-cat">{{categoryName}}</text>
      <text class="panel-demo">示例数据</text>
    </view>

    <text class="panel-name">{{product.name}}</text>
    <text class="panel-en">{{product.nameEn}}</text>

    <view class="panel-price"><text class="yen">¥</text>{{priceText}}</view>

    <text class="panel-desc">{{product.description}}</text>

    <view class="qty-row">
      <text class="qty-label">数量</text>
      <quantity-stepper
        value="{{qty}}"
        min="{{1}}"
        max="{{99}}"
        bind:change="onQtyChange"
      ></quantity-stepper>
    </view>

    <view wx:if="{{unavailable}}" class="add-btn is-disabled">已下架</view>
    <button
      wx:else
      class="add-btn"
      hover-class="add-btn--pressed"
      bindtap="onAdd"
    >加入购物车</button>

    <view class="cart-link" wx:if="{{!unavailable}}" hover-class="cart-link--pressed" bindtap="onGoCart">去看购物车</view>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">加载中…</view>

<empty-state
  wx:if="{{!loading && !product}}"
  text="{{error || '商品不存在'}}"
  hint="返回酒单看看其他商品"
></empty-state>