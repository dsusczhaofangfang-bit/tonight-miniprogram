/* 商品详情：顶部大图或酒标占位块 + 底部内容面板。
   全站唯一允许的一层阴影就用在这个面板上（docs/04 §3）。 */

.product {
  min-height: 100vh;
  background: #0B0A09;
}

.cover {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 46vh;
  background: #241610;
}

.cover-img {
  width: 100%;
  height: 100%;
}

/* 占位块内框：只在没有真实图片时出现 */
.cover-frame {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.28);
}

.cover-cat {
  color: #C9A86E;
  font-size: 30rpx;
  letter-spacing: 12rpx;
  text-indent: 12rpx;
}

.cover-en {
  margin-top: 12rpx;
  color: rgba(201, 168, 110, 0.7);
  font-size: 18rpx;
  letter-spacing: 4rpx;
  text-indent: 4rpx;
}

.cover-demo {
  margin-top: 18rpx;
  color: rgba(160, 143, 126, 0.75);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.panel {
  position: relative;
  margin-top: -32rpx;
  padding: 40rpx 32rpx 48rpx;
  border-radius: 16rpx 16rpx 0 0;
  background: #17110D;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.5);
}

.panel-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.panel-cat {
  color: #A08F7E;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.panel-demo {
  color: rgba(160, 143, 126, 0.7);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.panel-name {
  display: block;
  margin-top: 12rpx;
  color: #F4ECDF;
  font-size: 40rpx;
  letter-spacing: 3rpx;
}

.panel-en {
  display: block;
  margin-top: 6rpx;
  color: #A08F7E;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.panel-price {
  margin-top: 20rpx;
  color: #D9A45B;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 40rpx;
}

.yen {
  margin-right: 4rpx;
  font-size: 24rpx;
}

.panel-desc {
  display: block;
  margin-top: 16rpx;
  color: #A08F7E;
  font-size: 24rpx;
  line-height: 1.8;
}

.qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(201, 168, 110, 0.18);
}

.qty-label {
  color: #F4ECDF;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 32rpx;
  border: 1rpx solid rgba(201, 168, 110, 0.45);
  border-radius: 4rpx;
  background: #5A1A24;
  color: #F4ECDF;
  font-size: 30rpx;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
}

.add-btn--pressed {
  opacity: 0.8;
}

.add-btn.is-disabled {
  border-color: rgba(160, 143, 126, 0.25);
  background: #1F1915;
  color: rgba(160, 143, 126, 0.6);
}

.cart-link {
  margin-top: 24rpx;
  color: #C9A86E;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.cart-link--pressed {
  opacity: 0.5;
}

.loading {
  padding: 120rpx 0;
  color: #A08F7E;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  text-align: center;
}