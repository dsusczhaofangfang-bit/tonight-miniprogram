# 统一换行符：仓库内一律 LF，避免 Windows / macOS 混合提交产生整文件 diff
* text=auto eol=lf

# 二进制文件：不做换行与文本转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.wav   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary

# 小程序模板与样式按 HTML / CSS 统计语言构成
*.wxml linguist-language=HTML
*.wxss linguist-language=CSS
*.wxs  linguist-language=JavaScript

# 文档与生成物不计入语言统计
docs/**                 linguist-documentation
styles/font-hakkou.wxss linguist-generated=true